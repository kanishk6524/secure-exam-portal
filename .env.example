# Supabase Postgres: DATABASE_URL is the pooled connection (used by the app),
# DIRECT_URL is the direct connection (used by `prisma migrate`). Get both
# from your Supabase project's Connect dialog.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-secret"   # generate with: openssl rand -base64 32
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-cron-secret"

# Email (Resend) — get a key at https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
# Sandbox default only delivers to the address you signed up with. Verify a
# domain at https://resend.com/domains and switch this to e.g.
# "Exam Platform <no-reply@yourdomain.com>" so it can email real students/admins.
RESEND_FROM="Exam Platform <onboarding@resend.dev>"