# Copy this file to `.env` (Prisma reads .env, not .env.local).
#
# LOCAL DEVELOPMENT (no Supabase / Firebase needed):
#   docker compose up -d
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_platform"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/exam_platform"
#   leave FIREBASE_API_KEY empty -> accounts are plain local password accounts, no email verification
#   npx prisma migrate deploy && npx prisma db seed && npm run dev
#
# Supabase Postgres: DATABASE_URL is the pooled connection (used by the app),
# DIRECT_URL is the direct connection (used by `prisma migrate`). Get both
# from your Supabase project's Connect dialog.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-secret"   # generate with: openssl rand -base64 32
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-cron-secret"

# Firebase Authentication — used for registration, email verification, and
# password reset emails (sent by Firebase itself, no separate email provider
# needed). Get this from Firebase console → Project settings → General → Web
# API Key. Also enable Authentication → Sign-in method → Email/Password.
FIREBASE_API_KEY="your-firebase-web-api-key"
# Browser lockdown: tab switches, fullscreen exits and copy/cut/paste attempts allowed before the exam is auto-submitted (default 5)
MAX_LOCKDOWN_VIOLATIONS="5"

# Invite code required to register an admin account. If unset, admin self-registration is disabled.
ADMIN_REGISTRATION_CODE="replace-with-a-long-random-code"
# Optional: password for `prisma db seed` users (a random one is printed otherwise).
# SEED_PASSWORD=""

# Secure Exam Client (desktop-client/): when REQUIRE_SECURE_CLIENT=1 the exam can only be started from the signed desktop app.
# REQUIRE_SECURE_CLIENT="0"
# SECURE_CLIENT_SECRET="replace-with-a-long-random-string"
# Evidence: max webcam snapshots stored per exam session (default 80)
# MAX_EVIDENCE_SNAPSHOTS="80"

# Phone as a second (side) camera. A phone only allows its camera on HTTPS, so open the portal through an HTTPS tunnel
# (for example: brew install cloudflared && cloudflared tunnel --url http://localhost:3001) and put that address here.
# PUBLIC_BASE_URL="https://your-tunnel-name.trycloudflare.com"
# REQUIRE_PHONE_CAMERA="0"   # 1 = candidates cannot begin until the phone camera is connected
