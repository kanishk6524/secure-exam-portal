DATABASE_URL="mongodb://localhost:27017/exam_platform"
AUTH_SECRET="replace-with-a-long-random-secret"   # generate with: openssl rand -base64 32
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-cron-secret"

# Email (Resend) — get a key at https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
# Sandbox default only delivers to the address you signed up with. Verify a
# domain at https://resend.com/domains and switch this to e.g.
# "Exam Platform <no-reply@yourdomain.com>" so it can email real students/admins.
RESEND_FROM="Exam Platform <onboarding@resend.dev>"