{
  "name": "secure-exam-client",
  "version": "1.0.0",
  "description": "Locked-down desktop client for the Online Exam Portal",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.examportal.secureclient",
    "productName": "Secure Exam Client",
    "files": ["main.js", "preload.js", "checks.js", "preflight.html", "pin.html", "config.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
